# ------------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is git-ignored.
# ------------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (PostgreSQL) -------------------------------------------------
# Matches docker-compose.yml. `?schema=public` is required by Prisma.
DATABASE_URL="postgresql://saas:saas@localhost:5432/saas_marketplace?schema=public"

# --- Auth.js (NextAuth v5) ------------------------------------------------
# Generate with: `npx auth secret`  (or `openssl rand -base64 32`)
AUTH_SECRET="replace-me-with-a-32-byte-base64-secret"
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Optional OAuth providers (leave blank to disable the button)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Payment providers (abstracted; safe to leave blank in dev) ----------
PAYMENTS_DEFAULT_PROVIDER=mock            # mock | stripe | paypal | payu

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

PAYU_POS_ID=
PAYU_MD5_KEY=
PAYU_OAUTH_CLIENT_ID=
PAYU_OAUTH_CLIENT_SECRET=

# --- API platform --------------------------------------------------------
# HMAC pepper mixed into API-key hashing (rotate carefully).
API_KEY_HASH_PEPPER="replace-me-with-a-random-string"
API_DEFAULT_RATE_LIMIT_PER_MIN=120

# --- Feature flags / seed ----------------------------------------------
SEED_USER_PASSWORD="Password123!"
